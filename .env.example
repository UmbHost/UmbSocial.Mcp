# UmbSocial MCP server configuration
# Copy this file outside your project folder, fill in your values, and set
# UMBSOCIAL_ENV_FILE to its full path. The server reads no other .env file.
# Never commit it.

# ============================================================================
# Required: the Umbraco site and its API user
# ============================================================================

# The site's address. It must use https; plain http is allowed only for
# localhost, 127.0.0.1 or [::1].
UMBRACO_BASE_URL=https://localhost:44391

# The client credentials of an API user in a group with the Social section.
UMBRACO_CLIENT_ID=your-client-id
UMBRACO_CLIENT_SECRET=your-client-secret

# ============================================================================
# A local site with a self-signed certificate
# ============================================================================
# Trust the certificate rather than turning TLS checks off:
# NODE_EXTRA_CA_CERTS=/path/to/dev-certificate.pem
# (or start Node with --use-system-ca when the certificate is in the system store)

# ============================================================================
# Optional: UmbSocial
# ============================================================================

# Turn on slices that are off by default (comma-separated):
#   approve   approve and return posts awaiting approval
#   manage    change and delete campaigns, tags, hashtag groups and short links
#   settings  channels, schedules, mappings, approvals, links, AI and automatic posting
#   resolve   retry a failed target and mark a target published
# UMBSOCIAL_ENABLE_SLICES=approve

# Don't start the chained CMS Developer MCP (no cms-- tools)
# DISABLE_MCP_CHAINING=true

# Override the Umbraco major this server expects
# UMBRACO_EXPECTED_MAJOR=17

# ============================================================================
# Optional: the SDK's tool filtering
# ============================================================================

# UMBRACO_TOOL_MODES=social,social-pro
# UMBRACO_INCLUDE_TOOL_COLLECTIONS=social
# UMBRACO_EXCLUDE_TOOL_COLLECTIONS=social-pro
# UMBRACO_INCLUDE_SLICES=read,list
# UMBRACO_EXCLUDE_SLICES=delete
# UMBRACO_INCLUDE_TOOLS=list-posts,get-post
# UMBRACO_EXCLUDE_TOOLS=delete-post

# Only tools that read
# UMBRACO_READONLY=true
