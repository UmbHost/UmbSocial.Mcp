{
  "name": "@umbhost/umbsocial-mcp",
  "version": "1.0.0",
  "type": "module",
  "description": "MCP server for UmbSocial: read the Social calendar and write draft posts on an Umbraco 17 site.",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./collections": "./dist/collections.js",
    "./tool-types": {
      "types": "./dist/tool-types.d.ts"
    }
  },
  "bin": {
    "umbsocial-mcp": "./dist/index.js"
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsup --config tsup.config.ts",
    "postbuild": "umbraco-mcp-generate-types",
    "compile": "tsc --noEmit",
    "watch": "tsup --config tsup.config.ts --watch",
    "generate": "orval --config orval.config.ts",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --testPathPatterns=__tests__ --runInBand"
  },
  "engines": {
    "node": ">=22.3.0"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "Umbraco",
    "UmbSocial",
    "MCP",
    "Model Context Protocol"
  ],
  "author": "UmbHost Limited",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@umbraco-cms/mcp-server-sdk": "1.0.0-beta.47",
    "dotenv": "17.4.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@jest/globals": "30.5.2",
    "@types/jest": "30.0.0",
    "@types/node": "22.20.5",
    "jest": "30.5.2",
    "msw": "2.15.0",
    "orval": "8.45.0",
    "rimraf": "6.1.3",
    "ts-jest": "29.4.15",
    "tsup": "8.5.1",
    "typescript": "5.9.3"
  }
}
